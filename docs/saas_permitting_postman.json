				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"exec": [
									"const response = pm.response.json();",
									"if (response.token) {",
									"    pm.environment.set(\"jwt_token\", response.token);",
									"    console.log(\"JWT Token guardado en la variable: jwt_token\");",
									"}"
								],
								"type": "text/javascript"
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"email\": \"admin@acme-permits.com\",\n  \"password\": \"supersecretpassword123\"\n}"
						},
						"url": {
